# Server-only key used for YouTube duration, description, caption availability, and tags.
YOUTUBE_API_KEY=

# Server-only key for GPT-5.4 mini transcript analysis and future chat.
OPENAI_API_KEY=

# Optional OAuth access token. YouTube only permits caption downloads when the
# signed-in account can edit the video, so this does not unlock arbitrary videos.
YOUTUBE_OAUTH_ACCESS_TOKEN=
