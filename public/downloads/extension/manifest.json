{
  "manifest_version": 3,
  "name": "ReSync Capture",
  "version": "0.2.1",
  "description": "Capture YouTube transcripts and article text into ReSync.",
  "permissions": ["activeTab", "alarms", "scripting", "storage", "tabs"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://youtu.be/*",
    "https://*.mtbishmam.chatgpt.site/*"
  ],
  "action": {
    "default_title": "Capture in ReSync",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.mtbishmam.chatgpt.site/*"],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
